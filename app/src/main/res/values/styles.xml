<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="themeNavaBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView.PrimarySurface">
        <item name="itemPaddingTop">4dp</item> <item name="itemPaddingBottom">4dp</item> <item name="itemIconSize">20dp</item> </style>

    <style name="ShapeAppearanceOverlay.App.FloatingActionButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>

    </style>
    <style name="RoundedCorner">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Stili per i font personalizzati -->
    <style name="TextAppearance.App.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/roboto_mono</item>
        <item name="android:fontFamily">@font/roboto_mono</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/quattrocento_sans</item>
        <item name="android:fontFamily">@font/quattrocento_sans</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="fontFamily">@font/roboto_mono</item>
        <item name="android:fontFamily">@font/roboto_mono</item>
    </style>

    <style name="TextAppearance.App.Subtitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="fontFamily">@font/roboto_mono</item>
        <item name="android:fontFamily">@font/roboto_mono</item>
    </style>

    <!-- Stili semplificati per applicazione diretta -->
    <style name="AppTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="fontFamily">@font/roboto_mono</item>
        <item name="android:fontFamily">@font/roboto_mono</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppBody" parent="TextAppearance.MaterialComponents.Body1">
        <item name="fontFamily">@font/quattrocento_sans</item>
        <item name="android:fontFamily">@font/quattrocento_sans</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Stile per FAB centrato -->
    <style name="CenteredFAB" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="android:layout_gravity">center</item>
        <item name="fabSize">normal</item>
    </style>

</resources>